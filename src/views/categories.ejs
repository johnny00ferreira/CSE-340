<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Explore our service project categories:</p>

        <ul class="category-list">
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>