<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a href="/new-category">
                    Add New Category
                </a>
            </p>
            <% } %>

                <ul class="category-list">
                    <% categories.forEach(category=> { %>
                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
    </main>

    <%- include('partials/footer') %>