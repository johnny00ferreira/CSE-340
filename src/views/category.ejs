<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= category.name %>
        </h2>

        <h3>Service Projects</h3>

        <ul class="project-list">
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>